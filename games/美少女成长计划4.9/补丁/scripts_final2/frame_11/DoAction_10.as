function 执行行程()
{
   野外音乐.stop();
   开场音乐.stop();
   游戏音乐.stop();
   工作音乐.gotoAndPlay(1);
   场景.gotoAndStop(2);
   场景.确定._visible = false;
   if(所有工作[月工作1].关联 == 0)
   {
      场景.显示.text += 所有工作[月工作1].第一次说;
   }
   if(所有工作[月工作1].关联 < 20)
   {
      随机参数 = 3;
   }
   else if(所有工作[月工作1].关联 > 155)
   {
      随机参数 = 9;
   }
   else
   {
      随机参数 = 5;
   }
   if(所有工作[月工作1].关联 <= 40)
   {
      工作等级 = 1;
      提示等级 = "初级";
   }
   else if(所有工作[月工作1].关联 > 40 and 所有工作[月工作1].关联 <= 155)
   {
      工作等级 = 1.3;
      提示等级 = "中级";
   }
   else if(所有工作[月工作1].关联 > 155 and 所有工作[月工作1].关联 <= 400)
   {
      工作等级 = 1.6;
      提示等级 = "高级";
   }
   else
   {
      工作等级 = 1.9;
      提示等级 = "专家";
   }
   判断升级变化(月工作1);
   数值 = 1;
   第一轮 = setInterval(第一个十天,游戏速度);
}
