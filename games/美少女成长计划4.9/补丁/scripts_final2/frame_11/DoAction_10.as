function 处理说话()
{
   主面板._visible = false;
   对话框.头像.gotoAndStop(this["头像" + 哪句]);
   对话框.名字.text = this["名字" + 哪句];
   对话框.说话框.text = this["说话" + 哪句];
   对话框.前.onRelease = function()
   {
      if(哪句 > 1)
      {
         哪句 -= 1;
         处理说话();
      }
   };
   对话框.后.onRelease = function()
   {
      if(哪句 < 讲几句)
      {
         哪句 += 1;
         处理说话();
      }
      else
      {
         更新数值();
         对话框._visible = false;
         主面板._visible = true;
      }
   };
}
