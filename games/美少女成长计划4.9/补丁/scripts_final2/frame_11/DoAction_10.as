function 第三个十天()
{
   游戏时间();
   计算特殊日子();
   if(事件触发 == 0)
   {
      if(日 <= 30 and 日 > 18)
      {
         if(所有工作[月工作3].类型 !== "冒险" and 所有工作[月工作3].类型 !== "旅游")
         {
            执行每个月(月工作3);
            日++;
            星期++;
            日期属性++;
         }
         else if(生病状态 !== 1)
         {
            记录当月状态参数 = 月工作3;
            clearInterval(第一轮);
            clearInterval(第二轮);
            clearInterval(第三轮);
            if(所有工作[月工作3].类型 == "冒险")
            {
               attachMovie("战斗系统","战斗系统",220,{_x:0,_y:0});
            }
            else if(所有工作[月工作3].类型 == "旅游")
            {
               度假系统();
            }
         }
         else
         {
            月工作3 = 28;
            第三个十天();
         }
      }
      else
      {
         clearInterval(第三轮);
         场景.确定._visible = true;
         trace("过了一个月");
      }
   }
   else
   {
      trace("有没有扫描");
      clearInterval(第三轮);
      发送值1 = "三十天";
   }
}
