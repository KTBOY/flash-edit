function 身材函数()
{
   if(体重 - 110 > 0)
   {
      体重指数 = "胖";
      差值 = (体重 - 110) / 110;
   }
   else
   {
      体重指数 = "瘦";
      差值 = (体重 - 110) * -1 / 110;
   }
   if(体重指数 == "胖")
   {
      胸围 = Math.round(95 * (1 + 差值));
      腰围 = Math.round(80 * (1 + 差值 * 2));
      臀围 = Math.round(97 * (1 + 差值));
   }
   else
   {
      胸围 = Math.round(95 * (1 - 差值));
      腰围 = Math.round(80 * (1 - 差值 * 2));
      臀围 = Math.round(97 * (1 - 差值));
   }
}
