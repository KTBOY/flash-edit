function 游戏时间()
{
   if(日 > 30)
   {
      日 = 1;
      月 += 1;
   }
   if(月 > 12)
   {
      月 = 1;
      年 += 1;
      年龄 += 1;
      主面板.年龄.text = 年龄;
   }
   if(星期 > 7)
   {
      星期 = 1;
   }
   if(日期属性 > 5)
   {
      日期属性 = 1;
   }
   if(星期 == 1)
   {
      星期几 = "星期一";
   }
   else if(星期 == 2)
   {
      星期几 = "星期二";
   }
   else if(星期 == 3)
   {
      星期几 = "星期三";
   }
   else if(星期 == 4)
   {
      星期几 = "星期四";
   }
   else if(星期 == 5)
   {
      星期几 = "星期五";
   }
   else if(星期 == 6)
   {
      星期几 = "星期六";
   }
   else if(星期 == 7)
   {
      星期几 = "星期天";
   }
   if(日期属性 == 1)
   {
      日属性 = "属性：金";
   }
   else if(日期属性 == 2)
   {
      日属性 = "属性：木";
   }
   else if(日期属性 == 3)
   {
      日属性 = "属性：水";
   }
   else if(日期属性 == 4)
   {
      日属性 = "属性：火";
   }
   else if(日期属性 == 5)
   {
      日属性 = "属性：土";
   }
   查看随机条件();
   时间.text = "青龙年 " + 年 + "年 " + 月 + "月 " + 日 + "日";
   计算日期 = 年 + "" + 月 + "" + 日;
   计算重要日子 = 月 + "_" + 日;
   星期TXT.text = 星期几;
   日期属性TXT.text = 日属性;
}
