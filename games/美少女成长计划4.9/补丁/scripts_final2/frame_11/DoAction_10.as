         else if(所有工作[月工作3].关联 > 40 and 所有工作[月工作3].关联 <= 155)
         {
            工作等级 = 1.3;
            提示等级 = "中级";
         }
         else if(所有工作[月工作3].关联 > 155 and 所有工作[月工作3].关联 <= 400)
         {
            工作等级 = 1.6;
            提示等级 = "高级";
         }
         else
         {
            工作等级 = 1.9;
            提示等级 = "专家";
         }
         判断升级变化(月工作3);
         数值 = 1;
         第三轮 = setInterval(第三个十天,游戏速度);
         clearInterval(第二轮);
      }
   }
   else
   {
      clearInterval(第二轮);
      发送值1 = "二十天";
   }
}
function 判断升级变化(对象)
{
   this["等级" + 对象] = 工作等级;
   switch(this["目标" + 对象])
   {
      default:
         工作升级了 = 1;
         发送工作项目 = 对象;
         trace("升级了");
      case undefined:
      case this["等级" + 对象]:
         return;
   }
}
